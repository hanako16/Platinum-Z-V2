local lastFPSTime = tick()
local frameCount  = 0

RS.Heartbeat:Connect(function()
    pcall(function()
        frameCount = frameCount + 1
        local now  = tick()
        if now - lastFPSTime >= 1 then
            local fps  = math.floor(frameCount / (now - lastFPSTime))
            frameCount = 0
            lastFPSTime = now

            local ping = 0
            pcall(function()
                ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            end)

            local pingColor = ping < 80 and Color3.fromRGB(80, 200, 100)
                or (ping < 160 and Color3.fromRGB(220, 190, 60) or Color3.fromRGB(220, 80, 80))
            local fpsColor  = fps >= 50 and Color3.fromRGB(80, 200, 100)
                or (fps >= 25 and Color3.fromRGB(220, 190, 60) or Color3.fromRGB(220, 80, 80))

            pingLbl.Text       = "Ping: " .. ping .. "ms"
            pingLbl.TextColor3 = pingColor
            fpsLbl.Text        = "FPS: " .. fps
            fpsLbl.TextColor3  = fpsColor
            kitLbl.Text        = "Kit: " .. activeKitName
            killsLbl.Text      = "Session: " .. PZ.kills .. "  |  Hop at " .. PZ.targetKills
        end
    end)
end)

