local function notify(title, text)
    pcall(function()
        SG:SetCore("SendNotification", {
            Title    = title or "Platinum Z V2",
            Text     = text  or "",
            Duration = 2.5,
        })
    end)
end

local function click()
    pcall(function()
        if mouse1click then
            mouse1click()
        elseif VIM then
            VIM:SendMouseButtonEvent(0, 0, 0, true, game, 0)
            task.wait(0.025)
            VIM:SendMouseButtonEvent(0, 0, 0, false, game, 0)
        end
    end)
end

local function pressKey(keyName)
    pcall(function()
        if keyName == "Space" then
            if keypress and keyrelease then
                keypress(Enum.KeyCode.Space.Value)
                task.wait(0.04)
                keyrelease(Enum.KeyCode.Space.Value)
            elseif VIM then
                VIM:SendKeyEvent(true, Enum.KeyCode.Space, false, game)
                task.wait(0.04)
                VIM:SendKeyEvent(false, Enum.KeyCode.Space, false, game)
            end
            return
        end
        if keyName == "Q" then
            if keypress and keyrelease then
                keypress(Enum.KeyCode.Q.Value)
                task.wait(0.04)
                keyrelease(Enum.KeyCode.Q.Value)
            elseif VIM then
                VIM:SendKeyEvent(true, Enum.KeyCode.Q, false, game)
                task.wait(0.04)
                VIM:SendKeyEvent(false, Enum.KeyCode.Q, false, game)
            end
            return
        end
        local key = Enum.KeyCode[keyName]
        if not key then return end
        if keypress and keyrelease then
            keypress(key.Value)
            task.wait(0.04)
            keyrelease(key.Value)
        elseif VIM then
            VIM:SendKeyEvent(true, key, false, game)
            task.wait(0.04)
            VIM:SendKeyEvent(false, key, false, game)
        end
    end)
end

local function getHRP(c)
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function getHum(c)
    return c and c:FindFirstChildOfClass("Humanoid")
end

local function isAlive(c)
    local h = getHum(c)
    return h and h.Health > 0 and getHRP(c)
end

-- ============================================================
-- DEATH COUNTER / EVASIVE DETECTION
-- Avoid players currently in death counter / invuln / ragdoll escape
-- ============================================================
local function isDeathCounter(plr, char)
    if not plr or not char then return false end

    -- 1) Explicit attributes / values used by many TSB scripts
    local attrNames = {
        "DeathCounter", "DeathCounterActive", "InDeathCounter",
        "Counter", "IsCountering", "Countering",
        "Evasive", "UsingEvasive", "Invincible", "IFrames",
        "Ragdoll", "IsRagdolled", "Stunned", "NoHit"
    }
    for _, name in ipairs(attrNames) do
        local ok, val = pcall(function() return char:GetAttribute(name) end)
        if ok and val then return true end
        ok, val = pcall(function() return plr:GetAttribute(name) end)
        if ok and val then return true end
        local v = char:FindFirstChild(name) or plr:FindFirstChild(name)
        if v then
            if v:IsA("BoolValue") and v.Value then return true end
            if v:IsA("NumberValue") and v.Value > 0 then return true end
            if v:IsA("IntValue") and v.Value > 0 then return true end
        end
    end

    -- 2) Common folder / effect names under character
    local badNames = {
        "DeathCounter", "Counter", "Evasive", "IFrame", "Invuln",
        "ForceField", "ForceField2", "NoDamage", "RagdollConstraint"
    }
    for _, n in ipairs(badNames) do
        if char:FindFirstChild(n) then return true end
    end

    -- 3) ForceField = invuln window
    if char:FindFirstChildOfClass("ForceField") then return true end

    -- 4) Humanoid state that usually means untargetable / recovery
    local hum = getHum(char)
    if hum then
        local st = hum:GetState()
        if st == Enum.HumanoidStateType.Dead
            or st == Enum.HumanoidStateType.Physics
            or st == Enum.HumanoidStateType.Ragdoll
            or st == Enum.HumanoidStateType.FallingDown then
            return true
        end
        -- Very high WalkSpeed often means dash/evasive iframe
        if hum.WalkSpeed > 45 then return true end
    end

    return false
end

-- ============================================================
-- CHARACTER DETECTION
-- ============================================================
local function detectCharacter()
    local char = LP.Character
    if not char then return "Unknown" end

    local candidates = {
        char:FindFirstChild("CharacterName"),
        char:FindFirstChild("CharName"),
        char:FindFirstChild("SelectedCharacter"),
        LP:FindFirstChild("CharacterName"),
        LP:FindFirstChild("SelectedCharacter"),
        LP:FindFirstChild("Character"),
    }
    for _, v in ipairs(candidates) do
        if v and v:IsA("StringValue") then
            local name = tostring(v.Value)
            if name and name ~= "" then return name end
        end
    end

    for _, attrName in ipairs({"Character", "CharacterName", "Char", "Selected"}) do
        local ok, val = pcall(function() return char:GetAttribute(attrName) end)
        if ok and type(val) == "string" and val ~= "" then return val end
        ok, val = pcall(function() return LP:GetAttribute(attrName) end)
        if ok and type(val) == "string" and val ~= "" then return val end
    end

    local searchRoots = {char, LP:FindFirstChild("Backpack"), LP:FindFirstChild("PlayerGui")}
    local nameHints = {
        ["Consecutive"] = "The Strongest Hero",
        ["Normal Punch"] = "The Strongest Hero",
        ["Flowing Water"] = "Hero Hunter",
        ["Hunter"] = "Hero Hunter",
        ["Machine Gun"] = "Destructive Cyborg",
        ["Ignition"] = "Destructive Cyborg",
        ["Shuriken"] = "Deadly Ninja",
        ["Flash Strike"] = "Deadly Ninja",
        ["Homerun"] = "Brutal Demon",
        ["Beatdown"] = "Brutal Demon",
        ["Atmos"] = "Blade Master",
        ["Cleave"] = "Blade Master",
        ["Windstorm"] = "Wild Psychic",
        ["Stone Coffin"] = "Wild Psychic",
        ["Bullet Barrage"] = "Martial Artist",
        ["Vanishing"] = "Martial Artist",
    }
    for _, root in ipairs(searchRoots) do
        if not root then continue end
        for _, desc in ipairs(root:GetDescendants()) do
            local n = desc.Name
            for hint, mapped in pairs(nameHints) do
                if string.find(n, hint, 1, true) then
                    return mapped
                end
            end
        end
    end

    local hum = getHum(char)
    if hum and hum.DisplayName and hum.DisplayName ~= LP.Name then
        return hum.DisplayName
    end
    return char.Name or "Unknown"
end

local function resolveCombo(charName)
    if not charName or charName == "Unknown" then
        return DefaultCombo.sequence, "Default"
    end
    local lower = string.lower(charName)
    for kitName, data in pairs(Combos) do
        if string.lower(kitName) == lower then
            return data.sequence, kitName
        end
        for _, alias in ipairs(data.aliases or {}) do
            if string.find(lower, string.lower(alias), 1, true)
                or string.find(string.lower(alias), lower, 1, true) then
                return data.sequence, kitName
            end
        end
    end
    return DefaultCombo.sequence, "Default"
end

