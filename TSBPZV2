-- AIMLOCK
-- ============================================================
local function aimAt(target)
    if not target then return end
    local myChar = LP.Character
    local myHRP  = getHRP(myChar)
    local tHRP   = getHRP(target.char)
    if not myHRP or not tHRP then return end

    local look   = tHRP.CFrame.LookVector
    local behind = tHRP.Position - look * 4.4 + Vector3.new(0, 0.15, 0)
    myHRP.CFrame = CFrame.new(behind, tHRP.Position)

    pcall(function()
        local head = target.char:FindFirstChild("Head")
        if head then
            workspace.CurrentCamera.CFrame = CFrame.new(
                workspace.CurrentCamera.CFrame.Position,
                head.Position
            )
        end
    end)
end

-- ============================================================
-- TARGET SELECTION (skips death counter / invuln)
-- ============================================================
local RANGE = 280

local function getAllEnemies()
    local myHRP = getHRP(LP.Character)
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local c = plr.Character
        if not isAlive(c) then continue end
        if isDeathCounter(plr, c) then continue end   -- avoid death counter
        local hrp = getHRP(c)
        local hum = getHum(c)
        local dist = (myHRP.Position - hrp.Position).Magnitude
        if dist > RANGE then continue end
        local maxHP = hum.MaxHealth
        if maxHP <= 0 then continue end
        table.insert(list, {
            player = plr,
            char   = c,
            hrp    = hrp,
            hum    = hum,
            dist   = dist,
            hpPct  = hum.Health / maxHP,
            hp     = hum.Health,
        })
    end
    return list
end

local function pickTarget()
    local enemies = getAllEnemies()
    if #enemies == 0 then return nil end

    if PZ.finishing and PZ.currentTarget then
        local ct = PZ.currentTarget
        -- Drop if they went into death counter / invuln mid-fight
        if isAlive(ct.char) and not isDeathCounter(ct.player, ct.char) then
            local hum = getHum(ct.char)
            local hrp = getHRP(ct.char)
            if hum and hrp then
                ct.hp    = hum.Health
                ct.hpPct = hum.Health / math.max(hum.MaxHealth, 1)
                ct.hrp   = hrp
            end
            return ct
        else
            PZ.finishing     = false
            PZ.currentTarget = nil
        end
    end

    local lowTarget = nil
    local lowestHP  = math.huge
    local anyTarget = nil
    local closestD  = math.huge

    for _, e in ipairs(enemies) do
        if e.dist < closestD then
            closestD  = e.dist
            anyTarget = e
        end
        if e.hpPct <= 0.40 and e.hp < lowestHP then
            lowestHP  = e.hp
            lowTarget = e
        end
    end

    local chosen = lowTarget or anyTarget
    if chosen then
        PZ.finishing     = true
        PZ.currentTarget = chosen
    end
    return chosen
end

-- ============================================================
-- COMBO RUNNER — M1 filler when abilities on CD
-- ============================================================
local abilityCooldowns = {}
local ABILITY_CD = 0.85
local comboRunning = false
local activeSequence = DefaultCombo.sequence
local activeKitName  = "Default"

local function refreshCharacter()
    if tick() - PZ.lastCharCheck < 2.5 then return end
    PZ.lastCharCheck = tick()
    local name = detectCharacter()
    if name ~= PZ.currentChar then
        PZ.currentChar = name
        activeSequence, activeKitName = resolveCombo(name)
        notify("Platinum Z V2", "Kit: " .. activeKitName)
    end
end

local function anyAbilityReady()
  local now = tick()
    for _, key in ipairs({"One", "Two", "Three", "Four"}) do
        local last = abilityCooldowns[key] or 0
        if now - last >= ABILITY_CD then
            return true
        end
    end
    return false
end

local function runM1Filler()
    -- Pure M1 pressure while abilities recover
    for _ = 1, 4 do
        click()
        task.wait(0.09)
    end
end

local function runCombo()
    if comboRunning then return end
    comboRunning = true
    task.spawn(function()
        -- If every main ability is still on CD, just M1 and exit
        if not anyAbilityReady() then
            runM1Filler()
            task.wait(0.05)
            comboRunning = false
            return
        end

        local usedAnyAbility = false
        for _, step in ipairs(activeSequence) do
            if step.type == "m1" then
                for _ = 1, step.count do
                    click()
                    task.wait(step.wait)
                end
            elseif step.type == "key" then
                local now = tick()
                local last = abilityCooldowns[step.key] or 0
                local cd = (step.key == "Q" or step.key == "Space") and 0.35 or ABILITY_CD
                if now - last >= cd then
                    pressKey(step.key)
                    abilityCooldowns[step.key] = now
                    usedAnyAbility = true
                    task.wait(step.wait)
                else
                    -- Ability on CD → throw M1s instead of dead air
                    click()
                    task.wait(0.07)
                    click()
                    task.wait(0.07)
                end
            end
        end

        -- Extra safety: if the whole sequence skipped abilities, fill with M1
        if not usedAnyAbility then
            runM1Filler()
        end

        task.wait(0.05)
        comboRunning = false
    end)
end

-- ============================================================
-- KILL TRACKING — single increment only (debounce + clamp)
-- ============================================================
local lastKnownKills = 0

local function updateKills()
    local ls = LP:FindFirstChild("leaderstats")
    if not ls then return end
    local kv = ls:FindFirstChild("Kills")
        or ls:FindFirstChild("kills")
        or ls:FindFirstChild("Kill")
    if not kv then return end
    if not (kv:IsA("IntValue") or kv:IsA("NumberValue")) then return end

    local current = kv.Value

    if not PZ.killsSeeded then
        lastKnownKills = current
        PZ.killsSeeded = true
        return
    end

    if current > lastKnownKills then
        local gained = current - lastKnownKills
        -- Clamp: one real kill should never add more than 1 to session
        -- (TSB sometimes fires the value change twice in the same frame)
        if gained > 1 then gained = 1 end

        -- Debounce: ignore another increment within 1.2s of the last accepted kill
        local now = tick()
        if now - PZ.lastKillTime < 1.2 then
            lastKnownKills = current   -- still advance the seed so we don't stack later
            return
        end

        PZ.kills       = PZ.kills + gained
        lastKnownKills = current
        PZ.lastKillTime = now

        notify("Platinum Z V2", "Kill +" .. gained .. " | Session: " .. PZ.kills)
        PZ.finishing     = false
        PZ.currentTarget = nil
    end
end

-- ============================================================
-- SERVER HOP
-- ============================================================
local function serverHop()
    if tick() - PZ.lastHop < 8 then return end
    PZ.lastHop = tick()
    notify("Platinum Z V2", "Hopping after " .. PZ.kills .. " kills...")
    PZ.kills          = 0
    PZ.killsSeeded    = false
    PZ.finishing      = false
    PZ.currentTarget  = nil
    PZ.lastKillTime   = 0
    pcall(function()
        local pid     = game.PlaceId
        local servers = {}
        local req  = game:HttpGet(
            "https://games.roblox.com/v1/games/" .. pid ..
            "/servers/Public?sortOrder=Asc&limit=100"
        )
        local data = HttpService:JSONDecode(req)
        if data and data.data then
            for _, s in ipairs(data.data) do
                if s.playing
                    and s.playing < s.maxPlayers
                    and s.id ~= game.JobId then
                    table.insert(servers, s.id)
                end
            end
        end
        if #servers > 0 then
            TS:TeleportToPlaceInstance(pid, servers[math.random(1, #servers)], LP)
        else
            TS:Teleport(pid, LP)
        end
    end)
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
LP.CharacterAdded:Connect(function()
    task.wait(0.7)
    PZ.killsSeeded   = false
    PZ.finishing     = false
    PZ.currentTarget = nil
    PZ.currentChar   = "Unknown"
    PZ.lastCharCheck = 0
    PZ.lastKillTime  = 0
    abilityCooldowns = {}
end)

local function mainLoop()
    local myChar = LP.Character
    if not myChar then return end
    local myHum = getHum(myChar)
    if not myHum or myHum.Health <= 0 then return end

    refreshCharacter()

    local target = pickTarget()
    if target then
        aimAt(target)
        if not comboRunning then runCombo() end
    end

    if tick() - PZ.lastKillCheck > 1.0 then
        PZ.lastKillCheck = tick()
        updateKills()
        if PZ.kills >= PZ.targetKills then
            serverHop()
        end
    end
end

