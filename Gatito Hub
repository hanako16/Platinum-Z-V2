local function notify(title, text)
    pcall(function()
        SG:SetCore("SendNotification",{Title=title or "Gatito Hub",Text=text or "",Duration=2.5})
    end)
end
local function click()
    pcall(function() if mouse1click then mouse1click() end end)
end
local function pressKey(keyName)
    pcall(function()
        local key = Enum.KeyCode[keyName]
        if not key then return end
        if keypress and keyrelease then
            keypress(key.Value) task.wait(0.04) keyrelease(key.Value)
        end
    end)
end
local function getHRP(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) return c and c:FindFirstChildOfClass("Humanoid")  end
local function isAlive(c)
    local h = getHum(c)
    return h and h.Health > 0 and getHRP(c)
end

-- ============================================================
-- AIMLOCK
-- ============================================================
local function aimAt(target)
    if not target then return end
    local myHRP = getHRP(LP.Character)
    local tHRP  = getHRP(target.char)
    if not myHRP or not tHRP then return end
    local look   = tHRP.CFrame.LookVector
    local behind = tHRP.Position - look * 4.5 + Vector3.new(0,0.2,0)
    myHRP.CFrame = CFrame.new(behind, tHRP.Position)
    pcall(function()
        local head = target.char:FindFirstChild("Head")
        if head then
            workspace.CurrentCamera.CFrame = CFrame.new(
                workspace.CurrentCamera.CFrame.Position, head.Position)
        end
    end)
end

-- ============================================================
-- TARGETING
-- ============================================================
local RANGE = 280
local function getAllEnemies()
    local myHRP = getHRP(LP.Character)
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local c = plr.Character
        if not isAlive(c) then continue end
        local hrp = getHRP(c) local hum = getHum(c)
        local dist = (myHRP.Position - hrp.Position).Magnitude
        if dist > RANGE then continue end
        local maxHP = hum.MaxHealth
        if maxHP <= 0 then continue end
        table.insert(list,{player=plr,char=c,hrp=hrp,hum=hum,
            dist=dist,hpPct=hum.Health/maxHP,hp=hum.Health})
    end
    return list
end

local function pickTarget()
    local enemies = getAllEnemies()
    if #enemies == 0 then return nil end
    if PZ.finishing and PZ.currentTarget then
        local ct = PZ.currentTarget
        if isAlive(ct.char) then
            local hum = getHum(ct.char) local hrp = getHRP(ct.char)
            if hum and hrp then
                ct.hp=hum.Health ct.hpPct=hum.Health/math.max(hum.MaxHealth,1) ct.hrp=hrp
            end
            return ct
        else
            PZ.finishing=false PZ.currentTarget=nil
        end
    end
    local lowTarget,lowestHP,anyTarget,closestD = nil,math.huge,nil,math.huge
    for _,e in ipairs(enemies) do
        if e.dist < closestD then closestD=e.dist anyTarget=e end
        if e.hpPct <= 0.40 and e.hp < lowestHP then lowestHP=e.hp lowTarget=e end
    end
    local chosen = lowTarget or anyTarget
    if chosen then PZ.finishing=true PZ.currentTarget=chosen end
    return chosen
end

-- ============================================================
-- CHARACTER DETECTION
-- ============================================================
local function detectCharacter()
    local char = LP.Character
    if not char then return "Unknown" end
    for _,attr in ipairs({"Character","Moveset","SelectedCharacter"}) do
        local v = char:GetAttribute(attr) or LP:GetAttribute(attr)
        if typeof(v)=="string" and v~="" then return v end
    end
    for _,name in ipairs({"Character","Moveset","SelectedCharacter","CurrentCharacter"}) do
        local v = char:FindFirstChild(name) or LP:FindFirstChild(name)
        if v then
            if v:IsA("StringValue") and v.Value~="" then return v.Value end
            if v:IsA("ObjectValue") and v.Value then return v.Value.Name end
        end
    end
    local tools={}
    for _,t in ipairs(char:GetChildren()) do if t:IsA("Tool") then table.insert(tools,t.Name) end end
    local bp=LP:FindFirstChild("Backpack")
    if bp then for _,t in ipairs(bp:GetChildren()) do if t:IsA("Tool") then table.insert(tools,t.Name) end end end
    local ts=table.concat(tools," "):lower()
    if     ts:find("consecutive") or ts:find("serious")   then return "Saitama"
    elseif ts:find("flowing")     or ts:find("hunter")    then return "Garou"
    elseif ts:find("machine gun") or ts:find("ignition")  then return "Genos"
    elseif ts:find("shuriken")    or ts:find("scatter")   then return "Sonic"
    elseif ts:find("homerun")     or ts:find("beatdown")  then return "MetalBat"
    elseif ts:find("atmos")       or ts:find("slice")     then return "Atomic"
    elseif ts:find("windstorm")   or ts:find("coffin")    then return "Tatsumaki"
    elseif ts:find("barrage")     or ts:find("vanishing") then return "Suiryu"
    end
    return "Unknown"
end

