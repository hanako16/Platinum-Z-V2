local abilityCooldowns = {One=0,Two=0,Three=0,Four=0}
local ABILITY_CD       = 0.9
local currentChar      = "Unknown"
local lastCharCheck    = 0

local function getActiveCombo()
    if tick()-lastCharCheck > 3 then
        lastCharCheck = tick()
        currentChar   = detectCharacter()
    end
    return CharCombos[currentChar] or CharCombos["Unknown"]
end

local comboRunning = false
local function runCombo()
    if comboRunning then return end
    comboRunning = true
    task.spawn(function()
        for _,step in ipairs(getActiveCombo()) do
            if step.type=="m1" then
                for i=1,step.count do click() task.wait(step.wait) end
            elseif step.type=="key" then
                local now=tick()
                if now-(abilityCooldowns[step.key] or 0)>=ABILITY_CD then
                    pressKey(step.key) abilityCooldowns[step.key]=now
                end
                task.wait(step.wait)
            elseif step.type=="dash" then
                pressKey("Q") task.wait(step.wait)
            elseif step.type=="jump" then
                pressKey("Space") task.wait(step.wait)
            end
        end
        task.wait(0.08)
        comboRunning = false
    end)
end

-- ============================================================
-- KILL TRACKING
-- ============================================================
local lastKnownKills = 0
local function updateKills()
    local ls = LP:FindFirstChild("leaderstats")
    if not ls then return end
    local kv = ls:FindFirstChild("Kills") or ls:FindFirstChild("kills") or ls:FindFirstChild("Kill")
    if not kv then return end
    if not (kv:IsA("IntValue") or kv:IsA("NumberValue")) then return end
    local current = kv.Value
    if not PZ.killsSeeded then lastKnownKills=current PZ.killsSeeded=true return end
    if current > lastKnownKills then
        local gained=current-lastKnownKills
        PZ.kills=PZ.kills+gained lastKnownKills=current
        notify("Gatito Hub","Kill +"..gained.." | Session: "..PZ.kills)
        PZ.finishing=false PZ.currentTarget=nil
    end
end

-- ============================================================
-- SERVER HOP
-- ============================================================
local function serverHop()
    if tick()-PZ.lastHop < 8 then return end
    PZ.lastHop=tick()
    notify("Gatito Hub","Hopping after "..PZ.kills.." kills...")
    PZ.kills=0 PZ.killsSeeded=false PZ.finishing=false PZ.currentTarget=nil
    pcall(function()
        local pid=game.PlaceId local servers={}
        local req=game:HttpGet("https://games.roblox.com/v1/games/"..pid.."/servers/Public?sortOrder=Asc&limit=100")
        local data=HttpService:JSONDecode(req)
        if data and data.data then
            for _,s in ipairs(data.data) do
                if s.playing and s.playing<s.maxPlayers and s.id~=game.JobId then
                    table.insert(servers,s.id)
                end
            end
        end
        if #servers>0 then TS:TeleportToPlaceInstance(pid,servers[math.random(1,#servers)],LP)
        else TS:Teleport(pid,LP) end
    end)
end

-- ============================================================
-- MAIN LOOP
-- ============================================================
LP.CharacterAdded:Connect(function()
    task.wait(0.6)
    PZ.killsSeeded=false PZ.finishing=false PZ.currentTarget=nil
end)

local function mainLoop()
    if not PZ.autoFarm then return end
    local myChar=LP.Character
    if not myChar then return end
    local myHum=getHum(myChar)
    if not myHum or myHum.Health<=0 then return end
    local target=pickTarget()
    if target then
        aimAt(target)
        if not comboRunning then runCombo() end
    end
    if tick()-PZ.lastKillCheck > 1.0 then
        PZ.lastKillCheck=tick()
        updateKills()
        if PZ.serverHop and PZ.kills>=PZ.targetKills then serverHop() end
    end
end

PZ.conn = RS.Heartbeat:Connect(function() pcall(mainLoop) end)

