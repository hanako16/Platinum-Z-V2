local function getHRP(c) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHum(c) return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(c)
    local h = getHum(c)
    return h and h.Health > 0 and getHRP(c)
end

local function pressKey(keyName)
    pcall(function()
        local key = Enum.KeyCode[keyName]
        if keyName == "Space" then key = Enum.KeyCode.Space
        elseif keyName == "Q" then key = Enum.KeyCode.Q
        elseif keyName == "G" then key = Enum.KeyCode.G
        end
        if not key then return end
        if keypress and keyrelease then
            keypress(key.Value); task.wait(0.03); keyrelease(key.Value)
        else
            VIM:SendKeyEvent(true, key, false, game)
            task.wait(0.03)
            VIM:SendKeyEvent(false, key, false, game)
        end
    end)
end

local function doM1()
    -- NO mouse button events (removes cursor spam / menu opens)
    -- Tool activate + ability keys only; camera aims at target
    pcall(function()
        local char = LP.Character
        if not char then return end
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then tool:Activate() end
    end)
end

local function aimStick(target)
    if not target then return end
    local myHRP = getHRP(LP.Character)
    local tHRP = getHRP(target.char)
    if not myHRP or not tHRP then return end
    local behind = tHRP.Position - tHRP.CFrame.LookVector * S.stickDist + Vector3.new(0, 0.1, 0)
    myHRP.CFrame = CFrame.new(behind, tHRP.Position)
    -- auto aim camera (no mouse)
    pcall(function()
        Cam.CFrame = CFrame.new(Cam.CFrame.Position, tHRP.Position)
    end)
end

local function getLowHpEnemies()
    local myHRP = getHRP(LP.Character)
    if not myHRP then return {} end
    local list = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LP then continue end
        local c = plr.Character
        if not isAlive(c) then continue end
        local hum = getHum(c)
        local hrp = getHRP(c)
        local maxHP = hum.MaxHealth
        if maxHP <= 0 then continue end
        local pct = hum.Health / maxHP
        if pct > S.lowHpPct then continue end
        local dist = (myHRP.Position - hrp.Position).Magnitude
        if dist > S.range then continue end
        table.insert(list, {
            player = plr, char = c, hum = hum, hrp = hrp,
            hp = hum.Health, hpPct = pct, dist = dist, userid = plr.UserId,
        })
    end
    table.sort(list, function(a, b) return a.hp < b.hp end)
    return list
end

local function pickTarget()
    local list = getLowHpEnemies()
    if S.currentTarget then
        local ct = S.currentTarget
        for _, e in ipairs(list) do
            if e.userid == ct.userid and e.hp > 0 then
                ct.char = e.char; ct.hum = e.hum; ct.hrp = e.hrp
                ct.hp = e.hp; ct.hpPct = e.hpPct; ct.dist = e.dist
                return ct
            end
        end
        S.currentTarget = nil
    end
    if #list == 0 then return nil end
    S.currentTarget = list[1]
    S.noLowSince = tick()
    return S.currentTarget
end

