local function clearEsp()
    for uid, h in pairs(S.highlights) do
        pcall(function() h:Destroy() end)
        S.highlights[uid] = nil
    end
end

local function updateEsp()
    local low = getLowHpEnemies()
    local alive = {}
    for _, e in ipairs(low) do
        alive[e.userid] = true
        if not S.highlights[e.userid] or not S.highlights[e.userid].Parent then
            local hl = Instance.new("Highlight")
            hl.Name = "GatitoRed_" .. e.userid
            hl.Adornee = e.char
            hl.FillColor = Color3.fromRGB(255, 40, 40)
            hl.OutlineColor = Color3.fromRGB(255, 80, 80)
            hl.FillTransparency = 0.45
            hl.OutlineTransparency = 0.1
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = S.espFolder
            S.highlights[e.userid] = hl
        else
            S.highlights[e.userid].Adornee = e.char
        end
    end
    for uid, h in pairs(S.highlights) do
        if not alive[uid] then
            pcall(function() h:Destroy() end)
            S.highlights[uid] = nil
        end
    end
end

local function hopServer()
    if tick() - S.lastHop < 5 then return end
    S.lastHop = tick()
    S.currentTarget = nil
    clearEsp()
    pcall(function()
        local pid = game.PlaceId
        local servers = {}
        local req = game:HttpGet(
            "https://games.roblox.com/v1/games/" .. pid .. "/servers/Public?sortOrder=Asc&limit=100"
        )
        local data = HttpService:JSONDecode(req)
        if data and data.data then
            for _, srv in ipairs(data.data) do
                if srv.playing and srv.playing < srv.maxPlayers and srv.id ~= game.JobId then
                    table.insert(servers, srv.id)
                end
            end
        end
        if #servers > 0 then
            TS:TeleportToPlaceInstance(pid, servers[math.random(1, #servers)], LP)
        else
            TS:Teleport(pid, LP)
        end
    end)
end

local comboRunning = false
local lastAbility = {}
local function attackLoop(target)
    if comboRunning then return end
    comboRunning = true
    task.spawn(function()
        for _ = 1, 4 do
            if not S.farming or not target or not isAlive(target.char) then break end
            aimStick(target)
            doM1()
            task.wait(0.12)
        end
        for _, key in ipairs({"One", "Two", "Three", "Four"}) do
            if not S.farming then break end
            if tick() - (lastAbility[key] or 0) > 0.9 then
                pressKey(key)
                lastAbility[key] = tick()
                task.wait(0.15)
                doM1()
                task.wait(0.1)
            end
        end
        pressKey("Q")
        task.wait(0.08)
        comboRunning = false
    end)
end

local function mainLoop()
    if not S.farming then return end
    local myChar = LP.Character
    if not myChar or not getHum(myChar) or getHum(myChar).Health <= 0 then return end
    updateEsp()
    local target = pickTarget()
    if target then
        S.noLowSince = tick()
        aimStick(target)
        attackLoop(target)
    else
        if tick() - S.noLowSince >= S.hopWait then
            hopServer()
            S.noLowSince = tick()
        end
    end
end

